{
  "name": "floating-file-manager",
  "version": "1.1.0",
  "description": "桌面浮窗文件管理应用",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "lint": "eslint main.js preload.js renderer/scripts/**/*.js",
    "lint:fix": "eslint main.js preload.js renderer/scripts/**/*.js --fix",
    "format": "prettier --write \"**/*.js\" \"**/*.json\" \"**/*.html\" \"**/*.css\"",
    "build": "electron-builder --win",
    "build:portable": "electron-builder --win portable",
    "build:nsis": "electron-builder --win nsis"
  },
  "keywords": [
    "electron",
    "floating-window",
    "file-manager"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8.56.0",
    "prettier": "^3.2.0"
  },
  "build": {
    "appId": "com.floating.filemanager",
    "productName": "浮窗文件管理器",
    "directories": {
      "output": "dist-new"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "artifactName": "${productName}-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "浮窗文件管理器"
    }
  }
}
