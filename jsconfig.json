{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "checkJs": false,
    "resolveJsonModule": true,
    "esModuleInterop": true
  },
  "include": [
    "main.js",
    "preload.js",
    "src/**/*.js",
    "renderer/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "dist-new"
  ]
}
